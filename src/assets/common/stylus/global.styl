@import "./variable.styl"
.van-nav-bar .van-icon,.van-nav-bar__title{
  color: $color-common!important;
}
.van-hairline--top-bottom::after, .van-hairline-unset--top-bottom::after{
  border-width: 0 0 .03rem 0 !important;
} 
.van-tabs__wrap {
  height: 1.18rem !important;
}
.van-tab{
  font-size:$font-size-smaller !important;
}
.van-nav-bar__title{
  font-size:$font-size-smaller !important;
}
.van-field{
  font-size:$font-size-smaller-x !important;
}
.van-tabs__line{
  z-index:0 !important;
}
.van-picker__cancel{
 color: $color-common-b2!important;
}
.van-picker__confirm{
   color: $color-common!important;
}
.van-picker-column__item {
   color: $color-common!important;
}
.van-cell--large .van-cell__title{
  font-size:100% !important
}
*{
  touch-action: manipulation;
}

 html,body{
  position: absolute;
  top:0;
  left:0;
  width :100%;
  height: 100%;
  z-index:1;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
  color: $color-common-x;
  overflow-scrolling: touch;
  -webkit-overflow-scrolling: touch;//这个属性可以实现，手指离开屏幕会惯性滑动一段距离
  
}




img[data-src] {
  opacity: 0;
  transition: opacity .5s ease;
}

// ============================================
// 公共过渡动画（基于 animate.css @keyframes）
// 配合 <transition name="fade | slide-up | slide-down"> 使用
// ============================================

// 淡入淡出
.fade-enter-active
  animation fadeIn .3s both

.fade-leave-active
  animation fadeOut .3s both

// 上滑淡入 / 上滑淡出
.slide-up-enter-active
  animation fadeInUp .3s both

.slide-up-leave-active
  animation fadeOutDown .3s both

// 下滑淡入 / 下滑淡出
.slide-down-enter-active
  animation fadeInDown .3s both

.slide-down-leave-active
  animation fadeOutUp .3s both

// 一次性挂载淡入（替代 animate__animated animate__fadeIn）
.anim-fade-in
  animation fadeIn .5s both